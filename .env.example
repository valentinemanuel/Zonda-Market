# Valores de ejemplo para desarrollo local. Elegí tu propia contraseña.
POSTGRES_DB=zonda_market
POSTGRES_USER=zonda
POSTGRES_PASSWORD=

# Clave aleatoria de al menos 32 bytes codificada en Base64.
AUTH_JWT_KEY=
# AUTH_ALLOWED_ORIGINS=https://market.example

# Google OAuth es opcional. Usá un cliente web y registrá la URL exacta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/login/oauth2/code/google

# Correo local con Mailpit. Para la demo usá resend y un remitente autorizado.
MAIL_PROVIDER=mailpit
MAIL_FROM=avisos@zonda.test
MAILPIT_PORT=8025
# MAIL_PUBLIC_ORIGIN=http://localhost:3000
RESEND_API_KEY=

# Imágenes de desarrollo en PostgreSQL. Para Cloudinary, configurá las tres credenciales del servidor.
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usá demo para arrancar con el simulador de pagos deshabilitado.
SPRING_PROFILES_ACTIVE=local
# Opt-in de E7-02 para una base de demostración.
# DEMO_SEED_ENABLED=true
# DEMO_SEED_PASSWORD=
# DEMO_SEED_ADMIN_PASSWORD=

# Card Payment Brick de prueba. Los datos se obtienen del entorno Prueba de Mercado Pago Argentina.
MERCADO_PAGO_TEST_ENABLED=false
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_TEST_COLLECTOR_ID=0
MERCADO_PAGO_CARD_WEBHOOK_SECRET=

MERCADO_PAGO_PRO_TEST_ENABLED=false
MERCADO_PAGO_PRO_ACCESS_TOKEN=
MERCADO_PAGO_PRO_TEST_COLLECTOR_ID=0
MERCADO_PAGO_PRO_PUBLIC_ORIGIN=
MERCADO_PAGO_PRO_WEBHOOK_SECRET=

# Puertos publicados únicamente en loopback.
API_PORT=8080
WEB_PORT=3000
